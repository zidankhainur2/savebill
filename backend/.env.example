PORT=8080
FRONTEND_URL=http://localhost:3000

# Supabase Configuration (Dapatkan dari Supabase Dashboard -> Project Settings)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_secret_key
DATABASE_URL=postgres://postgres.your-project-id:your_db_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Google Gemini AI API Key (Dapatkan dari https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key
